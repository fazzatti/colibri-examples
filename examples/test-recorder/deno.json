{
  "imports": {
    "@colibri/core": "jsr:@colibri/core@1.3.1",
    "@colibri/test-tooling": "jsr:@colibri/test-tooling@1.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "stellar-sdk": "npm:@stellar/stellar-sdk@17.0.1"
  },
  "tasks": {
    "check": "deno check recording.ts output/*.ts tests/*.ts",
    "test:silent": "deno run -A @colibri/test-tooling/recorder/cli run --config=recording.ts -- -A tests",
    "test:summary": "deno run -A @colibri/test-tooling/recorder/cli run --config=output/summary.ts -- -A tests",
    "test:json": "deno run -A @colibri/test-tooling/recorder/cli run --config=output/json.ts -- -A tests",
    "test:html": "deno run -A @colibri/test-tooling/recorder/cli run --config=output/html.ts -- -A tests",
    "report": "deno run -A @colibri/test-tooling/recorder/cli aggregate"
  }
}
