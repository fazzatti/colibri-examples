{
  "workspace": ["./examples/*", "./getting-started/*"],
  "nodeModulesDir": "auto",
  "imports": {
    "@colibri/core": "jsr:@colibri/core@^0.30.0",
    "@colibri/webauth": "jsr:@colibri/webauth@^0.2.3",
    "@colibri/rpc-streamer": "jsr:@colibri/rpc-streamer@^0.4.0",
    "@colibri/test-tooling": "jsr:@colibri/test-tooling@^0.3.1",
    "@colibri/plugin-fee-bump": "jsr:@colibri/plugin-fee-bump@^0.10.5",
    "@colibri/plugin-channel-accounts": "jsr:@colibri/plugin-channel-accounts@^0.2.15",
    "@colibri/plugin-sep29": "jsr:@colibri/plugin-sep29@^0.1.1",
    "@colibri/identicon": "jsr:@colibri/identicon@^0.1.3",
    "@colibri/build-verification": "jsr:@colibri/build-verification@^0.4.3",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
    "stellar-sdk": "npm:@stellar/stellar-sdk@^17.0.1",
    "chalk": "npm:chalk@^5.3.0"
  },

  "tasks": {
    "check": "deno task --cwd examples/contract-bindings generate && deno check examples/**/*.ts getting-started/**/*.ts",
    "lint": "deno lint --config deno.json examples/**/*.ts getting-started/**/*.ts",
    "fmt:check": "deno fmt --check"
  },
  "exclude": [
    "**/target",
    "**/artifacts",
    "**/.verification",
    "**/.output",
    "./examples/contract-bindings/package"
  ],
  "lint": {
    "plugins": [],
    "rules": {
      "exclude": ["no-slow-types", "explicit-function-return-type"]
    }
  },
  "allowScripts": ["npm:cpu-features@0.0.10", "npm:ssh2@1.17.0"]
}
